#include <stdio.h>

struct Student
{
    int roll;
    char name[30];
    float marks;
};

int main()
{
    struct Student s[3];
    int i, max = 0;

    for(i = 0; i < 3; i++)
    {
        printf("Enter Roll Name Marks: ");
        scanf("%d %s %f", &s[i].roll, s[i].name, &s[i].marks);

        if(s[i].marks > s[max].marks)
            max = i;
    }

    printf("\nTopper Details\n");
    printf("Roll: %d\n", s[max].roll);
    printf("Name: %s\n", s[max].name);
    printf("Marks: %.2f\n", s[max].marks);

    return 0;
}
