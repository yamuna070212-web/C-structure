#include <stdio.h>

struct Book
{
    int id;
    char title[50];
    float price;
};

int main()
{
    struct Book b;

    printf("Enter Book ID: ");
    scanf("%d", &b.id);

    printf("Enter Book Title: ");
    scanf("%s", b.title);

    printf("Enter Price: ");
    scanf("%f", &b.price);

    printf("\nBook Details\n");
    printf("%d %s %.2f", b.id, b.title, b.price);

    return 0;
}
