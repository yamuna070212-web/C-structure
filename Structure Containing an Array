#include <stdio.h>

struct Student
{
    char name[30];
    int marks[3];
};

int main()
{
    struct Student s;
    int i;

    printf("Enter Name: ");
    scanf("%s", s.name);

    printf("Enter 3 Marks:\n");

    for(i = 0; i < 3; i++)
        scanf("%d", &s.marks[i]);

    printf("\n%s Marks:\n", s.name);

    for(i = 0; i < 3; i++)
        printf("%d ", s.marks[i]);

    return 0;
}
