#include <stdio.h>

struct Student
{
    int roll;
    char name[20];
};

int main()
{
    struct Student s[2];
    struct Student *ptr = s;
    int i;

    for(i = 0; i < 2; i++)
    {
        scanf("%d %s", &(ptr+i)->roll, (ptr+i)->name);
    }

    printf("\nStudent Details\n");

    for(i = 0; i < 2; i++)
    {
        printf("%d %s\n", (ptr+i)->roll, (ptr+i)->name);
    }

    return 0;
}
