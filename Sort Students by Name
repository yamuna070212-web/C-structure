#include <stdio.h>
#include <string.h>

struct Student
{
    char name[30];
};

int main()
{
    struct Student s[3], temp;
    int i, j;

    for(i = 0; i < 3; i++)
        scanf("%s", s[i].name);

    for(i = 0; i < 2; i++)
    {
        for(j = i + 1; j < 3; j++)
        {
            if(strcmp(s[i].name, s[j].name) > 0)
            {
                temp = s[i];
                s[i] = s[j];
                s[j] = temp;
            }
        }
    }

    printf("Sorted Names:\n");

    for(i = 0; i < 3; i++)
        printf("%s\n", s[i].name);

    return 0;
}
